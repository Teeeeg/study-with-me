{% import "clusters.njk" as ui %}

{% set navGroups = collections.docs | clusterGroups(clusters) %}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}知识库</title>
  <meta name="description" content="{{ description or '关于 AI、系统，以及路上遇到的一切的学习笔记。' }}">
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}?v={{ cssVersion }}">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='13' font-size='14'>📘</text></svg>">
</head>
<body>
  <a class="skip-link" href="#main">跳到正文</a>

  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="{{ '/' | url }}">
        <span class="brand-mark">SW</span>
        <span class="brand-name">知识库</span>
      </a>

      <nav class="topnav" aria-label="章节">
        <a href="{{ '/' | url }}"{% if ref == 'home' %} aria-current="page"{% endif %}>知识</a>
      </nav>

    </div>
  </header>

  <div class="shell">
    <aside class="sidebar">
      <p class="sidebar-heading">目录</p>
      <nav aria-label="目录">
        {{ ui.nav(navGroups, page.url) }}
      </nav>
    </aside>

    <main id="main" class="content">
      {{ content | safe }}
    </main>
  </div>

  <footer class="footer">
    <div class="footer-inner">
      <span>知识库</span>
    </div>
  </footer>

  <script>
    // Wide reference tables need their own scroll container on narrow screens.
    document.querySelectorAll(".content table").forEach(function (table) {
      var wrap = document.createElement("div");
      wrap.className = "table-wrap";
      table.parentNode.insertBefore(wrap, table);
      wrap.appendChild(table);
    });
  </script>
</body>
</html>
